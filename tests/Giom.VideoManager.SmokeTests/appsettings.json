{
  "Persistence": {
    "Provider": "Supabase"
  },
  "Topologia": {
    // US #106 — ChannelId REAL do Instituto/Ministério (antes "fake-instituto-teste"/
    // "fake-ministerio-teste", ver FakeVideoSource/Program.cs) — mesma topologia de
    // Orquestracao.Worker/appsettings.json, pra exercitar o fan-out real de cada canal
    // (Ministério é terminal em resumo, sem categorização nem embedding).
    "Canais": {
      "UCyyXFx2xHdzfavx6H6Q8zJw": "Instituto",
      "UCyHMyZH5oon8jW7y_yMRstQ": "Ministerio"
    },
    "Topologia": {
      "Instituto": {
        "transcricao": [ "resumo", "embedding" ],
        "resumo": [ "categorizacao" ],
        "categorizacao": [],
        "embedding": []
      },
      "Ministerio": {
        "transcricao": [ "resumo" ],
        "resumo": []
      }
    }
  },
  "ProcessingOptions": {
    "MaxVideosPerRun": 16,
    "ShouldGetCaption": true,
    "ShouldTranscribe": false,
    "ShouldGenerateSummary": true,
    "ShouldCategorize": true,
    "ShouldIndexEmbedding": true,
    "DelayBetweenPagesMs": 0,
    "DelayBetweenVideosMs": 500
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      // Unificado (Feature #104) — mesmo path que Resumo.Worker/Categorizacao.Worker usam em
      // dev (não mais /giom/dev/instituto/, path antigo de antes da unificação).
      "Path": "/giom/dev/pipeline/"
    }
  },
  "Helicone": {
    "ApiKey": "",
    "Environment": "teste"
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "teste",
    "TracesSampleRate": 1.0
  },
  "Supabase": {
    "Url": "https://postgrest-development-59c5.up.railway.app",
    "SecretKey": "",
    "RestPrefix": "",
    "SendAuthHeaders": false
  },
  "AlertaGasto": {
    "Habilitado": true,
    "LimiteDiarioUsd": 5.0
  },
  "FilaTranscricao": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-ingestao-dev",
      "Region": "us-east-1",
      "RateLimitDelaySeconds": 5
    },
    "RabbitMq": {
      "ConnectionString": "",
      "QueueName": "giom-videos-ingestao"
    }
  },
  "FilaResumo": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-resumo-dev",
      "Region": "us-east-1",
      "RateLimitDelaySeconds": 5
    }
  },
  "FilaCategorizacao": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-categorizacao-dev",
      "Region": "us-east-1",
      "RateLimitDelaySeconds": 5
    }
  },
  "FilaEmbedding": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-embedding-dev",
      "Region": "us-east-1",
      "RateLimitDelaySeconds": 5
    }
  },
  "FilaEtapaConcluida": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-etapa-concluida-teste-dev",
      "Region": "us-east-1",
      "RateLimitDelaySeconds": 5
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
