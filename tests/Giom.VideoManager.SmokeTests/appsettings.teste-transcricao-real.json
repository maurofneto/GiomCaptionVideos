{
  // Perfil de validação de DI da US #129 (Transcrição por canal) — rodar com
  // DOTNET_ENVIRONMENT=teste-transcricao-real. Só liga Transcricao:FallbackChain (Resumo/
  // Categorizacao/Embedding continuam Fake) — objetivo aqui é confirmar que
  // AddTranscriptionService resolve todo o grafo de DI (FallbackCaptionService +
  // IEtapaProvedorConfigService + os 4 providers keyed) sem crashar no boot, mesmo padrão do
  // Bug #135 (DI wiring do Whisper), NÃO validar transcrição real de vídeo.
  //
  // FakeVideoSource gera Video.Id sintético ("teste-{guid}") — nenhum dos 4 providers reais
  // (YouTubeCaption/YouTubeTranscript/YtDlpCaption/Whisper) vai achar esse vídeo de verdade no
  // YouTube, então a etapa video.transcricao vai falhar legitimamente pra todo vídeo desta run
  // (esgota a cadeia, cai na DLQ) — isso é ESPERADO, não é bug. MaxVideosPerRun baixo pra não
  // desperdiçar tentativas reais de yt-dlp/OAuth à toa.
  "Transcricao": {
    "FallbackChain": [ "YouTubeCaption", "YouTubeTranscript", "YtDlpCaption", "Whisper" ]
  },
  "ProcessingOptions": {
    "MaxVideosPerRun": 1
  }
}
