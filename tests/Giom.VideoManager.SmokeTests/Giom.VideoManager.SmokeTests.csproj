<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.17" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Sentry.Serilog" Version="6.6.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mesmos prompts do Instituto.Worker (linkados, não duplicados) — o pipeline de resumo/
         categorização real precisa deles mesmo rodando contra vídeos fake. -->
    <Content Include="..\..\src\Giom.VideoManager.Instituto.Worker\Prompts\*.md" LinkBase="Prompts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Giom.VideoManager.Domain\Giom.VideoManager.Domain.csproj" />
    <ProjectReference Include="..\..\src\Giom.VideoManager.Application\Giom.VideoManager.Application.csproj" />
    <ProjectReference Include="..\..\src\Giom.VideoManager.Composition\Giom.VideoManager.Composition.csproj" />
    <!-- Handlers de etapa genéricos (Feature #104) — mesmas classes dos workers de produção. -->
    <ProjectReference Include="..\..\src\Giom.VideoManager.Transcricao.Worker\Giom.VideoManager.Transcricao.Worker.csproj" />
    <ProjectReference Include="..\..\src\Giom.VideoManager.Resumo.Worker\Giom.VideoManager.Resumo.Worker.csproj" />
    <ProjectReference Include="..\..\src\Giom.VideoManager.Categorizacao.Worker\Giom.VideoManager.Categorizacao.Worker.csproj" />
    <ProjectReference Include="..\..\src\Giom.VideoManager.Embedding.Worker\Giom.VideoManager.Embedding.Worker.csproj" />
  </ItemGroup>

</Project>
