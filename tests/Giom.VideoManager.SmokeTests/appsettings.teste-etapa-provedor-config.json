{
  // Perfil de validação da US #106 (EtapaProvedorConfig por canal) — rodar com
  // DOTNET_ENVIRONMENT=teste-etapa-provedor-config. Ao contrário do appsettings.json base (que
  // usa Fake/OpenAI-only nas duas etapas pra não gastar API à toa), este perfil liga a cadeia
  // REAL de Resumo E Categorização (Claude → Grok → OpenAI, Model/Prompt SEM sobrescrever nada
  // — sem quebra proposital, ao contrário de appsettings.teste-fallback.json). Com
  // EtapaProvedorConfig:Provider não setado (default "Repository"), a config de cada chamada
  // vem de etapa_provedor_config (Supabase dev) pelo ChannelId real (ver Program.cs/
  // canaisDeTeste) — é isso que prova que o prompt/UsarObservabilidade por canal resolve de
  // verdade, e não só que a run não quebra.
  "Resumo": {
    "FallbackChain": [ "Claude", "Grok", "OpenAI" ]
  },
  "Categorizacao": {
    "FallbackChain": [ "Claude", "Grok", "OpenAI" ]
  }
}
