{
  // Perfil de teste da cadeia de fallback de Resumo (Feature #101) — rodar com
  // DOTNET_ENVIRONMENT=teste-fallback. Com Resumo:FallbackChain presente, o Program.cs troca o
  // FakeResumoService pela cadeia REAL (mesma composição dos workers):
  //   1. Claude — Model proposital e inválido abaixo → API devolve 404 → elo falha de verdade.
  //   2. Grok  — chave real do SSM (/giom/dev/instituto/GrokResumo/ApiKey); enquanto o time xAI
  //      estiver sem créditos, falha com 403 permission-denied → segundo fallback acionado.
  //   3. OpenAI — fecha a cadeia com um resumo real (gpt-4o-mini), gravado com Origem "OpenAI".
  // As demais etapas (transcrição/categorização/embedding) continuam nos Fakes com injeção de
  // falha — retry/DLQ segue coberto na mesma run.
  "Resumo": {
    "FallbackChain": [ "Claude", "Grok", "OpenAI" ]
  },
  "ClaudeResumo": {
    "ApiKey": "", // real vem do SSM — irrelevante, o Model inválido derruba o elo antes
    "Model": "claude-modelo-invalido-teste-fallback",
    "UseHelicone": false
  },
  "GrokResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/dev/instituto/GrokResumo/ApiKey)
    "Model": "grok-3-mini"
  },
  "OpenAiResumo": {
    "ApiKey": "", // injetada por env var OpenAiResumo__ApiKey na run de teste (não está no SSM ainda)
    "Model": "gpt-4o-mini"
  },
  "ProcessingOptions": {
    "MaxVideosPerRun": 8
  }
}
