{
  "Persistence": {
    "Provider": "Supabase"
  },
  "Topologia": {
    // Feature #104 — os canais de teste mapeiam pra topologia "Teste", com as 4 etapas (igual
    // Instituto real) pra exercitar o fan-out completo. ChannelId vem do FakeVideoSource
    // ("fake-instituto-teste"/"fake-ministerio-teste", ver Program.cs/canaisDeTeste, US #105).
    "Canais": {
      "fake-instituto-teste": "Teste",
      "fake-ministerio-teste": "Teste"
    },
    "Topologia": {
      "Teste": {
        "transcricao": [ "resumo", "embedding" ],
        "resumo": [ "categorizacao" ],
        "categorizacao": [],
        "embedding": []
      }
    }
  },
  "ProcessingOptions": {
    "MaxVideosPerRun": 16,
    "ShouldGetCaption": true,
    "ShouldTranscribe": false,
    "ShouldGenerateSummary": true,
    "ShouldCategorize": true,
    "ShouldIndexEmbedding": true,
    "DelayBetweenPagesMs": 0,
    "DelayBetweenVideosMs": 500
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/dev/instituto/"
    }
  },
  "Helicone": {
    "ApiKey": "",
    "Environment": "teste"
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "teste",
    "TracesSampleRate": 1.0
  },
  "Supabase": {
    "Url": "https://fajrstyqgogmqzceujjt.supabase.co",
    "SecretKey": ""
  },
  "AlertaGasto": {
    "Habilitado": true,
    "LimiteDiarioUsd": 5.0
  },
  "FilaTranscricao": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-ingestao-dev",
      "Region": "us-east-1",
      "RateLimitDelaySeconds": 5
    },
    "RabbitMq": {
      "ConnectionString": "",
      "QueueName": "giom-videos-ingestao"
    }
  },
  "FilaResumo": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-resumo-dev", "Region": "us-east-1", "RateLimitDelaySeconds": 5 }
  },
  "FilaCategorizacao": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-categorizacao-dev", "Region": "us-east-1", "RateLimitDelaySeconds": 5 }
  },
  "FilaEmbedding": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-embedding-dev", "Region": "us-east-1", "RateLimitDelaySeconds": 5 }
  },
  "FilaEtapaConcluida": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-etapa-concluida-teste-dev", "Region": "us-east-1", "RateLimitDelaySeconds": 5 }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
