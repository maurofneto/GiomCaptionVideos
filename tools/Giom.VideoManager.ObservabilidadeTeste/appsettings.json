{
  "Persistence": {
    "Provider": "Supabase"
  },
  "ProcessingOptions": {
    "MaxVideosPerRun": 8,
    "ShouldGetCaption": true,
    "ShouldTranscribe": false,
    "ShouldGenerateSummary": true,
    "ShouldCategorize": true,
    "ShouldIndexEmbedding": true,
    "DelayBetweenPagesMs": 0,
    "DelayBetweenVideosMs": 500
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/dev/instituto/"
    }
  },
  "Helicone": {
    "ApiKey": "",
    "Environment": "teste"
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "teste",
    "TracesSampleRate": 1.0
  },
  "Supabase": {
    "Url": "https://fajrstyqgogmqzceujjt.supabase.co",
    "SecretKey": ""
  },
  "AlertaGasto": {
    "Habilitado": true,
    "LimiteDiarioUsd": 5.0
  },
  "FilaTranscricao": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-ingestao-dev",
      "Region": "us-east-1"
    },
    "RabbitMq": {
      "ConnectionString": "",
      "QueueName": "giom-videos-ingestao"
    }
  },
  "FilaResumo": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-resumo-dev", "Region": "us-east-1" }
  },
  "FilaCategorizacao": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-categorizacao-dev", "Region": "us-east-1" }
  },
  "FilaEmbedding": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-embedding-dev", "Region": "us-east-1" }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
