{
  "Persistence": {
    "Provider": "Supabase"
  },
  "Embedding": {
    // US #118 — só os provedores que faltam no corpus existente. OpenAI fica de fora de
    // propósito: já indexado (Origem já gravada), reprocessar seria custo/tempo à toa —
    // cada IEmbeddingService checa a própria Origem antes de gravar (Bug #121), mas nem
    // vale a pena pagar a chamada de embedding só pra descobrir isso.
    "FallbackChain": [ "VoyageAI", "Cohere" ]
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/prod/pipeline/"
    }
  },
  "VoyageEmbedding": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/VoyageEmbedding/ApiKey)
    "Model": "voyage-3",
    "ChunkSize": 2400,
    "ChunkOverlap": 400,
    "EmbedBatchSize": 20
  },
  "CohereEmbedding": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/CohereEmbedding/ApiKey)
    "Model": "embed-v4.0",
    "ChunkSize": 2400,
    "ChunkOverlap": 400,
    "EmbedBatchSize": 90
  },
  "Sentry": {
    "Dsn": "", // secret — valor real só no SSM (/giom/prod/pipeline/Sentry/Dsn)
    "Environment": "backfill-prod",
    "TracesSampleRate": 1.0
  },
  "Supabase": {
    "Url": "https://rhjsjfbegtusucunkgav.supabase.co",
    "SecretKey": "" // secret — valor real só no SSM (/giom/prod/pipeline/Supabase/SecretKey)
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/backfill-embeddings-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
