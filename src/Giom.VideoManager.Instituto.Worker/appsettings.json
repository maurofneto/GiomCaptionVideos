{
  "Persistence": {
    "Provider": "Supabase"
  },
  "Transcription": {
    "Provider": "YouTubeCaption"
  },
  "YouTubeCaption": {
    "Formato": "sbv" // sbv, scc, srt, ttml, vtt
  },
  "Summary": {
    "Provider": "Claude"
  },
  "Embedding": {
    "Provider": "Direct"
  },
  "ProcessingOptions": {
    "MaxVideosPerRun": 20,
    "ShouldGetCaption": true,
    "ShouldTranscribe": false,
    "ShouldGenerateSummary": true,
    "ShouldCategorize": true,
    "ShouldIndexEmbedding": true,
    "DelayBetweenPagesMs": 1200,
    "DelayBetweenVideosMs": 5000
  },
  "Google": {
    "ClientId": "556782852780-7t0dmgmd7nogid1tfhn2v1i3kncu74br.apps.googleusercontent.com",
    "ClientSecret": "", // secret — valor real só no SSM (/giom/prod/instituto/Google/ClientSecret)
    "RefreshToken": "", // secret — valor real só no SSM (/giom/prod/instituto/Google/RefreshToken)
    "User": "mauro.furigo@gmail.com",
    "ApplicationName": "Giom Instituto Processor"
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/prod/instituto/"
    }
  },
  "ClaudeResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/ClaudeResumo/ApiKey)
    "Model": "claude-sonnet-5", // o resumo agora alimenta o contexto de resposta do bot (substituição por aula inteira) — justifica modelo melhor que Haiku
    "UseHelicone": true
  },
  "ClaudeCategorizacao": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/ClaudeCategorizacao/ApiKey)
    "Model": "claude-haiku-4-5-20251001", // classificação simples em JSON — Haiku é suficiente
    "UseHelicone": true
  },
  "Helicone": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/Helicone/ApiKey)
    "Environment": "prod"
  },
  "Sentry": {
    "Dsn": "" // secret — valor real só no SSM (/giom/prod/instituto/Sentry/Dsn), injetado em Serilog:WriteTo:Sentry:Args:dsn em runtime
  },
  "Supabase": {
    "Url": "https://rhjsjfbegtusucunkgav.supabase.co",
    "SecretKey": "" // secret — valor real só no SSM (/giom/prod/instituto/Supabase/SecretKey)
  },
  "DirectEmbedding": {
    "OpenAiApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/DirectEmbedding/OpenAiApiKey)
    "EmbeddingModel": "text-embedding-3-small",
    "ChunkSize": 2400,
    "ChunkOverlap": 400,
    "EmbedBatchSize": 20
  },
  "Whisper": {
    "YtDlpPath": "yt-dlp",
    "WhisperPath": "whisper",
    "Model": "medium",
    "TempDirectory": "C:\\Temp"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Sentry.Serilog" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/instituto-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Sentry",
        "Args": {
          "dsn": "", // preenchido em runtime a partir de Sentry:Dsn (SSM) — ver ConfigurationBuilderSentryExtensions.AddSentryDsnFromSecrets
          "environment": "instituto-prod",
          "minimumBreadcrumbLevel": "Information", // contexto (últimas linhas de log) anexado a cada evento de erro
          "minimumEventLevel": "Error" // só erro/exceção vira evento no Sentry — mesmo nível dos outros sinks não faria sentido aqui (viraria volume normal de log)
        }
      }
    ]
  }
}
