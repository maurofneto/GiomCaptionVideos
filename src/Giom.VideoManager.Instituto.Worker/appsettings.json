{
  "Persistence": {
    "Provider": "Supabase"
  },
  "Transcricao": {
    // Cadeia de fallback (Feature #101) — cai pro próximo só se o anterior falhar/lançar
    // exceção (ver FallbackChain/FallbackHandler). YouTubeCaption continua o principal aqui
    // (mesmo provider de antes), YtDlpCaption/Whisper como alternativas quando não há legenda.
    "FallbackChain": [ "YouTubeCaption", "YtDlpCaption", "Whisper" ]
  },
  "YouTubeCaption": {
    "Formato": "sbv" // sbv, scc, srt, ttml, vtt
  },
  "Resumo": {
    // Cadeia de fallback (Feature #101) — Claude continua o principal, Grok/OpenAI só entram
    // se Claude falhar.
    "FallbackChain": [ "Claude", "Grok", "OpenAI" ]
  },
  "Categorizacao": {
    "FallbackChain": [ "Claude", "Grok", "OpenAI" ]
  },
  "Embedding": {
    "Provider": "Direct"
  },
  "ProcessingOptions": {
    "MaxVideosPerRun": 20,
    "ShouldGetCaption": true,
    "ShouldTranscribe": false,
    "ShouldGenerateSummary": true,
    "ShouldCategorize": true,
    "ShouldIndexEmbedding": true,
    "DelayBetweenPagesMs": 1200,
    "DelayBetweenVideosMs": 5000
  },
  "Google": {
    "ClientId": "556782852780-7t0dmgmd7nogid1tfhn2v1i3kncu74br.apps.googleusercontent.com",
    "ClientSecret": "", // secret — valor real só no SSM (/giom/prod/instituto/Google/ClientSecret)
    "RefreshToken": "", // secret — valor real só no SSM (/giom/prod/instituto/Google/RefreshToken)
    "User": "mauro.furigo@gmail.com",
    "ApplicationName": "Giom Instituto Processor"
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/prod/instituto/"
    }
  },
  "ClaudeResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/ClaudeResumo/ApiKey)
    "Model": "claude-sonnet-5", // o resumo agora alimenta o contexto de resposta do bot (substituição por aula inteira) — justifica modelo melhor que Haiku
    "UseHelicone": true
  },
  "ClaudeCategorizacao": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/ClaudeCategorizacao/ApiKey)
    "Model": "claude-haiku-4-5-20251001", // classificação simples em JSON — Haiku é suficiente
    "UseHelicone": true
  },
  "GrokResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/GrokResumo/ApiKey) — elo de fallback (Feature #101), só acionado se Claude falhar
    "Model": "grok-3-mini"
  },
  "GrokCategorizacao": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/GrokCategorizacao/ApiKey)
    "Model": "grok-3-mini"
  },
  "OpenAiResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/OpenAiResumo/ApiKey) — último elo da cadeia de fallback
    "Model": "gpt-4o-mini"
  },
  "OpenAiCategorizacao": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/OpenAiCategorizacao/ApiKey)
    "Model": "gpt-4o-mini"
  },
  "Helicone": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/Helicone/ApiKey)
    "Environment": "prod"
  },
  "Sentry": {
    "Dsn": "", // secret — valor real só no SSM (/giom/prod/instituto/Sentry/Dsn)
    "Environment": "instituto-prod",
    "TracesSampleRate": 1.0 // habilita o Sentry Performance — ver LoggerConfigurationSentryExtensions.ConfigureSentry
  },
  "Supabase": {
    "Url": "https://rhjsjfbegtusucunkgav.supabase.co",
    "SecretKey": "" // secret — valor real só no SSM (/giom/prod/instituto/Supabase/SecretKey)
  },
  "DirectEmbedding": {
    "OpenAiApiKey": "", // secret — valor real só no SSM (/giom/prod/instituto/DirectEmbedding/OpenAiApiKey)
    "EmbeddingModel": "text-embedding-3-small",
    "ChunkSize": 2400,
    "ChunkOverlap": 400,
    "EmbedBatchSize": 20
  },
  "Whisper": {
    "YtDlpPath": "yt-dlp",
    "WhisperPath": "whisper",
    "Model": "medium",
    "TempDirectory": "C:\\Temp"
  },
  "AlertaGasto": {
    "Habilitado": true,
    "LimiteDiarioUsd": 5.0 // gasto estimado (resumo + categorização + embedding) acumulado no dia (UTC) — passou disso, dispara Critical (vira alerta no Sentry)
  },
  "FilaTranscricao": {
    "Provider": "Sqs", // ingestão desacoplada (US #39/#40) — Sqs (padrão) ou RabbitMq (CloudAMQP/LavinMQ) — Transcrição é só mais uma etapa (Feature #33), mesmo mecanismo de FilaResumo/FilaCategorizacao/FilaEmbedding
    "Sqs": {
      "QueueName": "giom-videos-ingestao-instituto-prod", // fila DEDICADA do Instituto, nunca compartilhada com o Ministério — criada automaticamente se não existir (SqsFilaCanal), não precisa provisionar antes
      "Region": "us-east-1"
    },
    "RabbitMq": {
      "ConnectionString": "", // secret — valor real só no SSM (/giom/prod/instituto/FilaTranscricao/RabbitMq/ConnectionString)
      "QueueName": "giom-videos-ingestao-instituto"
    }
  },
  "FilaResumo": {
    "Provider": "Sqs", // etapas independentes (Feature #33 — US #41/#42/#43)
    "Sqs": { "QueueName": "giom-videos-resumo-instituto-prod", "Region": "us-east-1" },
    "RabbitMq": { "ConnectionString": "", "QueueName": "giom-videos-resumo-instituto" }
  },
  "FilaCategorizacao": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-categorizacao-instituto-prod", "Region": "us-east-1" },
    "RabbitMq": { "ConnectionString": "", "QueueName": "giom-videos-categorizacao-instituto" }
  },
  "FilaEmbedding": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-embedding-instituto-prod", "Region": "us-east-1" },
    "RabbitMq": { "ConnectionString": "", "QueueName": "giom-videos-embedding-instituto" }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/instituto-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
