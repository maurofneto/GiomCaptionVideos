{
  "Persistence": {
    "Provider": "Supabase"
  },
  "Transcription": {
    "Provider": "YouTubeTranscript"
  },
  "Summary": {
    "Provider": "Claude"
  },
  "ProcessingOptions": {
    "MaxVideosPerRun": 35,
    "ShouldGetCaption": true,
    "ShouldTranscribe": false,
    "ShouldGenerateSummary": true,
    "ShouldCategorize": false,
    "ShouldIndexEmbedding": false,
    "DelayBetweenPagesMs": 1200,
    "DelayBetweenVideosMs": 3000
  },
  "Supabase": {
    "Url": "https://rhjsjfbegtusucunkgav.supabase.co",
    "SecretKey": "" // secret — valor real só no SSM (/giom/ministerio/Supabase/SecretKey)
  },
  "Google": {
    "ClientId": "556782852780-7t0dmgmd7nogid1tfhn2v1i3kncu74br.apps.googleusercontent.com",
    "ClientSecret": "", // secret — valor real só no SSM (/giom/ministerio/Google/ClientSecret)
    "RefreshToken": "", // secret — valor real só no SSM (/giom/ministerio/Google/RefreshToken)
    "User": "mauro.furigo@gmail.com",
    "ProjectId": "556782852780",
    "ApplicationName": "Giom Ministerio Processor"
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/ministerio/"
    }
  },
  "ClaudeResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/ministerio/ClaudeResumo/ApiKey)
    "Model": "claude-sonnet-5"
  },
  "Sentry": {
    "Dsn": "" // secret — valor real só no SSM (/giom/ministerio/Sentry/Dsn), injetado em Serilog:WriteTo:Sentry:Args:dsn em runtime
  },
  "YouTubeTranscript": {
    "Languages": [ "pt", "pt-BR", "en" ]
  },
  "Whisper": {
    "Model": "large-v3",
    "YtDlpPath": "yt-dlp",
    "WhisperPath": "whisper"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Sentry.Serilog" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ministerio-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Sentry",
        "Args": {
          "dsn": "", // preenchido em runtime a partir de Sentry:Dsn (SSM) — ver ConfigurationBuilderSentryExtensions.AddSentryDsnFromSecrets
          "environment": "ministerio",
          "minimumBreadcrumbLevel": "Information",
          "minimumEventLevel": "Error"
        }
      }
    ]
  }
}
