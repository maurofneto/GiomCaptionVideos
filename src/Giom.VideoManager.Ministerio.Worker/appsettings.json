{
  "Persistence": {
    "Provider": "Supabase"
  },
  "Transcricao": {
    // Cadeia de fallback (Feature #101) — YouTubeTranscript continua o principal (mesmo
    // provider de antes, sem quota/custo), YtDlpCaption/Whisper como alternativas.
    "FallbackChain": [ "YouTubeTranscript", "YtDlpCaption", "Whisper" ]
  },
  "Resumo": {
    // Cadeia de fallback (Feature #101) — Claude continua o principal.
    "FallbackChain": [ "Claude", "Grok", "OpenAI" ]
  },
  "ProcessingOptions": {
    "MaxVideosPerRun": 35,
    "ShouldGetCaption": true,
    "ShouldTranscribe": false,
    "ShouldGenerateSummary": true,
    "ShouldCategorize": false,
    "ShouldIndexEmbedding": false,
    "DelayBetweenPagesMs": 1200,
    "DelayBetweenVideosMs": 3000
  },
  "Supabase": {
    "Url": "https://rhjsjfbegtusucunkgav.supabase.co",
    "SecretKey": "" // secret — valor real só no SSM (/giom/prod/ministerio/Supabase/SecretKey)
  },
  "Google": {
    "ClientId": "556782852780-7t0dmgmd7nogid1tfhn2v1i3kncu74br.apps.googleusercontent.com",
    "ClientSecret": "", // secret — valor real só no SSM (/giom/prod/ministerio/Google/ClientSecret)
    "RefreshToken": "", // secret — valor real só no SSM (/giom/prod/ministerio/Google/RefreshToken)
    "User": "mauro.furigo@gmail.com",
    "ProjectId": "556782852780",
    "ApplicationName": "Giom Ministerio Processor"
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/prod/ministerio/"
    }
  },
  "ClaudeResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/ministerio/ClaudeResumo/ApiKey)
    "Model": "claude-sonnet-5"
  },
  "GrokResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/ministerio/GrokResumo/ApiKey) — elo de fallback (Feature #101), só acionado se Claude falhar
    "Model": "grok-3-mini"
  },
  "OpenAiResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/ministerio/OpenAiResumo/ApiKey) — último elo da cadeia de fallback
    "Model": "gpt-4o-mini"
  },
  "Sentry": {
    "Dsn": "", // secret — valor real só no SSM (/giom/prod/ministerio/Sentry/Dsn)
    "Environment": "ministerio-prod",
    "TracesSampleRate": 1.0 // habilita o Sentry Performance — ver LoggerConfigurationSentryExtensions.ConfigureSentry
  },
  "YouTubeTranscript": {
    "Languages": [ "pt", "pt-BR", "en" ]
  },
  "Whisper": {
    "Model": "large-v3",
    "YtDlpPath": "yt-dlp",
    "WhisperPath": "whisper"
  },
  "AlertaGasto": {
    "Habilitado": true,
    "LimiteDiarioUsd": 3.0 // gasto estimado (resumo) acumulado no dia (UTC) — passou disso, dispara Critical (vira alerta no Sentry)
  },
  "FilaTranscricao": {
    "Provider": "Sqs", // ingestão desacoplada (US #39/#40) — Sqs (padrão) ou RabbitMq (CloudAMQP/LavinMQ) — Transcrição é só mais uma etapa (Feature #33), mesmo mecanismo de FilaResumo
    "Sqs": {
      "QueueName": "giom-videos-ingestao-ministerio-prod", // fila DEDICADA do Ministério, nunca compartilhada com o Instituto — criada automaticamente se não existir (SqsFilaCanal), não precisa provisionar antes
      "Region": "us-east-1"
    },
    "RabbitMq": {
      "ConnectionString": "", // secret — valor real só no SSM (/giom/prod/ministerio/FilaTranscricao/RabbitMq/ConnectionString)
      "QueueName": "giom-videos-ingestao-ministerio"
    }
  },
  "FilaResumo": {
    "Provider": "Sqs", // etapas independentes (Feature #33 — US #41/#42/#43) — Ministério só tem Transcrição+Resumo
    "Sqs": { "QueueName": "giom-videos-resumo-ministerio-prod", "Region": "us-east-1" },
    "RabbitMq": { "ConnectionString": "", "QueueName": "giom-videos-resumo-ministerio" }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ministerio-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
