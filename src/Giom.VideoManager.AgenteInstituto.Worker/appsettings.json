{
  "Embedding": {
    "Provider": "SupabaseEdgeFunction"
  },
  "Supabase": {
    "Url": "https://rhjsjfbegtusucunkgav.supabase.co",
    "SecretKey": "" // secret — valor real só no SSM (/giom/prod/agenteinstituto/Supabase/SecretKey)
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/prod/agenteinstituto/"
    }
  },
  "ClaudeAgent": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/agenteinstituto/ClaudeAgent/ApiKey)
    "Model": "claude-sonnet-5",
    "UseHelicone": true
  },
  "Helicone": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/agenteinstituto/Helicone/ApiKey)
    "Environment": "prod"
  },
  "Sentry": {
    "Dsn": "" // secret — valor real só no SSM (/giom/prod/agenteinstituto/Sentry/Dsn), injetado em Serilog:WriteTo:Sentry:Args:dsn em runtime
  },
  "ConversaHistorico": {
    "Provider": "Supabase" // Supabase (persistido, sem limite de turnos) | MongoDB | InMemory
  },
  "Rag": {
    "CanalId": "UCyyXFx2xHdzfavx6H6Q8zJw" // restringe a busca semântica ao canal do Instituto Giom — nunca retorna conteúdo do Ministério
  },
  "Bot": {
    "MensagemBoasVindas": "Oi, irmão! Bem-vindo. Aqui você conversa direto comigo sobre o conteúdo das aulas do Instituto Teológico Giom — pode perguntar sobre Escatologia, Soteriologia, o que for. Manda sua pergunta que eu respondo. Se precisar, o /ajuda mostra os comandos disponíveis.",
    "MensagemSobre": "Sou o assistente de perguntas e respostas do Instituto Teológico Giom, treinado com o conteúdo das aulas do Dr. Wagner Cordeiro. As respostas são baseadas no que foi ensinado em aula — quando eu não tiver certeza de algo, eu aviso e indico procurar o Dr. Wagner diretamente.",
    "MensagemLimpar": "Prontinho, irmão — conversa zerada. Pode começar do zero, esqueci tudo que a gente tinha falado até agora."
  },
  "Telegram": {
    "BotToken": "" // secret — valor real só no SSM (/giom/prod/agenteinstituto/Telegram/BotToken)
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Sentry.Serilog" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/agente-instituto-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Sentry",
        "Args": {
          "dsn": "", // preenchido em runtime a partir de Sentry:Dsn (SSM) — ver ConfigurationBuilderSentryExtensions.AddSentryDsnFromSecrets
          "environment": "agenteinstituto-prod",
          "minimumBreadcrumbLevel": "Information",
          "minimumEventLevel": "Error",
          "tracesSampleRate": 1.0 // habilita o Sentry Performance — sem isso, SentrySdk.StartTransaction vira no-op
        }
      }
    ]
  }
}
