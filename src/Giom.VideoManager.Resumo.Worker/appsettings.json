{
  "Persistence": {
    "Provider": "Supabase"
  },
  "Resumo": {
    "FallbackChain": [ "Claude", "Grok", "OpenAI" ]
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/prod/pipeline/"
    }
  },
  "ClaudeResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/ClaudeResumo/ApiKey). Unificado (Feature #104): antes divergia entre instituto/ministerio, agora é 1 chave só pros 2 canais
    "Model": "claude-sonnet-5",
    "UseHelicone": true
  },
  "GrokResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/GrokResumo/ApiKey) — já era o mesmo valor duplicado entre instituto/ministerio antes da #104
    "Model": "grok-3-mini"
  },
  "OpenAiResumo": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/OpenAiResumo/ApiKey)
    "Model": "gpt-4o-mini"
  },
  "Helicone": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/Helicone/ApiKey)
    "Environment": "prod"
  },
  "Sentry": {
    "Dsn": "", // secret — valor real só no SSM (/giom/prod/pipeline/Sentry/Dsn)
    "Environment": "resumo-prod",
    "TracesSampleRate": 1.0
  },
  "Supabase": {
    "Url": "https://rhjsjfbegtusucunkgav.supabase.co",
    "SecretKey": "" // secret — valor real só no SSM (/giom/prod/pipeline/Supabase/SecretKey)
  },
  "FilaResumo": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-resumo-prod",
      "Region": "us-east-1"
    }
  },
  "FilaEtapaConcluida": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-etapa-concluida-prod",
      "Region": "us-east-1"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/resumo-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
