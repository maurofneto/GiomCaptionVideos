{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Secrets": {
    "Aws": {
      "Path": "/giom/dev/pipeline/"
    }
  },
  // Feature #115/US #117 — valida indexação em pipeline (todos os provedores, não só o
  // primeiro que funcionar) em dev antes de considerar habilitar em prod. Chaves Voyage/Cohere
  // já provisionadas no SSM (/giom/dev/pipeline/{VoyageEmbedding,CohereEmbedding}/ApiKey).
  "Embedding": {
    "Modo": "Pipeline",
    "FallbackChain": [ "OpenAI", "VoyageAI", "Cohere" ]
  },
  "Supabase": {
    "Url": "https://fajrstyqgogmqzceujjt.supabase.co"
  },
  "Helicone": {
    "Environment": "dev"
  },
  "Sentry": {
    "Environment": "pipeline-dev"
  },
  "FilaEmbedding": {
    "Sqs": {
      "QueueName": "giom-videos-embedding-dev"
    }
  },
  "FilaEtapaConcluida": {
    "Sqs": {
      "QueueName": "giom-videos-etapa-concluida-dev"
    }
  }
}
