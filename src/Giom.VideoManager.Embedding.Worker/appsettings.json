{
  "Persistence": {
    "Provider": "Supabase"
  },
  "Embedding": {
    "FallbackChain": [ "OpenAI" ]
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/prod/pipeline/"
    }
  },
  "OpenAiEmbedding": {
    "OpenAiApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/OpenAiEmbedding/OpenAiApiKey)
    "EmbeddingModel": "text-embedding-3-small",
    "ChunkSize": 2400,
    "ChunkOverlap": 400,
    "EmbedBatchSize": 20
  },
  // VoyageEmbedding/CohereEmbedding: chave já provisionada no SSM, mas nenhum dos dois está em
  // Embedding:FallbackChain ainda — pipeline de indexação com múltiplos provedores é a Feature
  // #115 (planejamento em andamento, corpus precisa ser reindexado antes de habilitar de verdade).
  "VoyageEmbedding": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/VoyageEmbedding/ApiKey)
    "Model": "voyage-3",
    "ChunkSize": 2400,
    "ChunkOverlap": 400,
    "EmbedBatchSize": 20
  },
  "CohereEmbedding": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/CohereEmbedding/ApiKey)
    "Model": "embed-v4.0",
    "ChunkSize": 2400,
    "ChunkOverlap": 400,
    "EmbedBatchSize": 90
  },
  "Helicone": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/Helicone/ApiKey)
    "Environment": "prod"
  },
  "Sentry": {
    "Dsn": "", // secret — valor real só no SSM (/giom/prod/pipeline/Sentry/Dsn)
    "Environment": "pipeline-prod",
    "TracesSampleRate": 1.0
  },
  "Supabase": {
    "Url": "https://rhjsjfbegtusucunkgav.supabase.co",
    "SecretKey": "" // secret — valor real só no SSM (/giom/prod/pipeline/Supabase/SecretKey)
  },
  "FilaEmbedding": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-embedding-prod",
      "Region": "us-east-1"
    }
  },
  "FilaEtapaConcluida": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-etapa-concluida-prod",
      "Region": "us-east-1"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/embedding-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
