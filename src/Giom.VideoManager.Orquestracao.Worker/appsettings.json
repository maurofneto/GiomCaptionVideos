{
  "Persistence": {
    "Provider": "Supabase"
  },
  "Topologia": {
    "Canais": {
      "UCyyXFx2xHdzfavx6H6Q8zJw": "Instituto",
      "UCyHMyZH5oon8jW7y_yMRstQ": "Ministerio"
    },
    "Topologia": {
      "Instituto": {
        "transcricao": [ "resumo", "embedding" ],
        "resumo": [ "categorizacao" ],
        "categorizacao": [],
        "embedding": []
      },
      "Ministerio": {
        "transcricao": [ "resumo" ],
        "resumo": []
      }
    }
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/prod/pipeline/"
    }
  },
  "Sentry": {
    "Dsn": "", // secret — valor real só no SSM (/giom/prod/pipeline/Sentry/Dsn)
    "Environment": "pipeline-prod",
    "TracesSampleRate": 1.0
  },
  "Supabase": {
    "Url": "https://rhjsjfbegtusucunkgav.supabase.co",
    "SecretKey": "" // secret — valor real só no SSM (/giom/prod/pipeline/Supabase/SecretKey)
  },
  "FilaEtapaConcluida": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-etapa-concluida-prod",
      "Region": "us-east-1"
    }
  },
  "FilaTranscricao": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-transcricao-prod", "Region": "us-east-1" }
  },
  "FilaResumo": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-resumo-prod", "Region": "us-east-1" }
  },
  "FilaCategorizacao": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-categorizacao-prod", "Region": "us-east-1" }
  },
  "FilaEmbedding": {
    "Provider": "Sqs",
    "Sqs": { "QueueName": "giom-videos-embedding-prod", "Region": "us-east-1" }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/orquestracao-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
