{
  "Persistence": {
    "Provider": "Supabase"
  },
  // Transcricao:FallbackChain removido (US #129) — a ordem/ativação dos 4 providers
  // (YouTubeCaption/YouTubeTranscript/YtDlpCaption/Whisper) agora vem de etapa_provedor_config
  // por canal (Supabase), não mais de appsettings. Ver migration
  // 20260812023700_etapa_provedor_config_embedding_transcricao.sql pro seed inicial (mesma
  // ordem que estava fixa aqui).
  "YouTubeCaption": {
    "Formato": "sbv"
  },
  "YouTubeTranscript": {
    "Languages": [ "pt", "pt-BR", "en" ]
  },
  "ProcessingOptions": {
    "ShouldGetCaption": true
  },
  "Google": {
    "ClientId": "556782852780-7t0dmgmd7nogid1tfhn2v1i3kncu74br.apps.googleusercontent.com",
    // ClientId compartilhado (override por canal: {secrets_key}:Google:ClientId). ClientSecret/
    // RefreshToken SÓ por canal — SSM /giom/prod/canais/{instituto,ministerio}/Google/...
    // (mesmo padrão da Ingestão #105). pipeline/ NÃO é fonte de credencial Google: chaves
    // Google:ClientSecret/Google:RefreshToken sem prefixo são ignoradas (com aviso no boot).
    "User": "mauro.furigo@gmail.com"
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      // pipeline/ = Whisper, Helicone, Sentry, Supabase, legado YtDlp:CookiesContent
      // canais/ = OAuth Google + cookies yt-dlp por canal (US #146)
      "Paths": [
        "/giom/prod/pipeline/",
        "/giom/prod/canais/"
      ],
      "Path": "/giom/prod/pipeline/"
    }
  },
  "Helicone": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/Helicone/ApiKey)
    "Environment": "prod"
  },
  "Sentry": {
    "Dsn": "", // secret — valor real só no SSM (/giom/prod/pipeline/Sentry/Dsn)
    "Environment": "pipeline-prod",
    "TracesSampleRate": 1.0
  },
  "Supabase": {
    "Url": "https://rhjsjfbegtusucunkgav.supabase.co",
    "SecretKey": "" // secret — valor real só no SSM (/giom/prod/pipeline/Supabase/SecretKey)
  },
  "YtDlp": {
    // US #146 — preferir /giom/{env}/canais/{instituto|ministerio}/YtDlp/CookiesContent
    // (Instituto:YtDlp:CookiesContent / Ministerio:YtDlp:CookiesContent após o loader SSM).
    // Este path legado (pipeline) só entra como fallback até os cookies por canal existirem.
    "CookiesContent": "" // secret — valor real só no SSM (/giom/prod/pipeline/YtDlp/CookiesContent)
  },
  "instituto": {
    "YtDlp": {
      "CookiesContent": "" // secret — SSM /giom/prod/canais/instituto/YtDlp/CookiesContent
    }
  },
  "ministerio": {
    "YtDlp": {
      "CookiesContent": "" // secret — SSM /giom/prod/canais/ministerio/YtDlp/CookiesContent
    }
  },
  "Whisper": {
    // Bug #134 — trocado de CLI local (Python/PyTorch, nunca instalado na imagem, nunca
    // funcionou de verdade) pra API de áudio da OpenAI. ApiKey pode reaproveitar a mesma
    // conta/valor do OpenAiEmbedding — mesmo secret físico, path próprio por clareza.
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/Whisper/ApiKey)
    "Model": "whisper-1",
    "TempDirectory": "/tmp"
  },
  "GrokVoice": {
    // US #148 — Grok Voice (xAI speech-to-text) como elo da cadeia de Transcrição, antes do Whisper.
    // Só entra na cadeia de um canal se houver linha dele em etapa_provedor_config (provedor='GrokVoice').
    "ApiKey": "", // secret — valor real só no SSM (/giom/{env}/pipeline/GrokVoice/ApiKey)
    "Model": "grok-voice-transcribe-2.0",
    "Language": "pt",
    "TempDirectory": "/tmp"
  },
  "FilaTranscricao": {
    // Fila única compartilhada entre Instituto e Ministério (Feature #104) — Video.ChannelId já
    // vem na mensagem, não precisa de fila por canal pra saber de quem é o vídeo.
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-transcricao-prod",
      "Region": "us-east-1"
    }
  },
  "FilaEtapaConcluida": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-etapa-concluida-prod",
      "Region": "us-east-1"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/transcricao-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
