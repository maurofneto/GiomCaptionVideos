{
  "Persistence": {
    "Provider": "Supabase"
  },
  "Transcricao": {
    // Cadeia de fallback (Feature #101/#104) — antes da #104, Instituto usava YouTubeCaption
    // (OAuth, dono do canal) e Ministério usava YouTubeTranscript (sem OAuth, canal de
    // terceiros) como principal — 2 configs diferentes, cada worker só tentava a sua. Agora que
    // é 1 worker só pros 2 canais, a cadeia inclui os dois: tenta YouTubeCaption primeiro (com
    // OAuth, funciona pro canal que o token autoriza), cai pra YouTubeTranscript se falhar
    // (sem OAuth, cobre o outro canal), depois YtDlpCaption/Whisper — mais resiliente pros 2
    // canais do que qualquer uma das configs antigas isoladas.
    "FallbackChain": [ "YouTubeCaption", "YouTubeTranscript", "YtDlpCaption", "Whisper" ]
  },
  "YouTubeCaption": {
    "Formato": "sbv"
  },
  "YouTubeTranscript": {
    "Languages": [ "pt", "pt-BR", "en" ]
  },
  "ProcessingOptions": {
    "ShouldGetCaption": true
  },
  "Google": {
    "ClientId": "556782852780-7t0dmgmd7nogid1tfhn2v1i3kncu74br.apps.googleusercontent.com",
    "ClientSecret": "", // secret — valor real só no SSM (/giom/prod/pipeline/Google/ClientSecret)
    "RefreshToken": "", // secret — valor real só no SSM (/giom/prod/pipeline/Google/RefreshToken)
    "User": "mauro.furigo@gmail.com",
    "ApplicationName": "Giom Pipeline Transcricao"
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/prod/pipeline/"
    }
  },
  "Helicone": {
    "ApiKey": "", // secret — valor real só no SSM (/giom/prod/pipeline/Helicone/ApiKey)
    "Environment": "prod"
  },
  "Sentry": {
    "Dsn": "", // secret — valor real só no SSM (/giom/prod/pipeline/Sentry/Dsn)
    "Environment": "pipeline-prod",
    "TracesSampleRate": 1.0
  },
  "Supabase": {
    "Url": "https://rhjsjfbegtusucunkgav.supabase.co",
    "SecretKey": "" // secret — valor real só no SSM (/giom/prod/pipeline/Supabase/SecretKey)
  },
  "Whisper": {
    "YtDlpPath": "yt-dlp",
    "WhisperPath": "whisper",
    "Model": "medium",
    "TempDirectory": "/tmp"
  },
  "FilaTranscricao": {
    // Fila única compartilhada entre Instituto e Ministério (Feature #104) — Video.ChannelId já
    // vem na mensagem, não precisa de fila por canal pra saber de quem é o vídeo.
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-transcricao-prod",
      "Region": "us-east-1"
    }
  },
  "FilaEtapaConcluida": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-etapa-concluida-prod",
      "Region": "us-east-1"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/transcricao-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
