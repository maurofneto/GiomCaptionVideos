{
  "Persistence": {
    "Provider": "Supabase"
  },
  "ProcessingOptions": {
    "MaxVideosPerRun": 20,
    "DelayBetweenPagesMs": 1200,
    "DelayBetweenVideosMs": 3000
  },
  "Google": {
    // ClientId compartilhado entre canais (confirmado: mesmo valor pra Instituto/Ministério
    // dentro de um ambiente) — vem daqui, não de canal_ingestao. ClientSecret/RefreshToken são
    // por canal, lidos de "{secrets_key}:Google:ClientSecret"/"RefreshToken" (ver
    // AddIngestaoMultiCanal), carregados do SSM sob Secrets:Aws:Path.
    "ClientId": "556782852780-7t0dmgmd7nogid1tfhn2v1i3kncu74br.apps.googleusercontent.com",
    "User": "mauro.furigo@gmail.com"
  },
  "Secrets": {
    "Provider": "AwsParameterStore",
    "Aws": {
      "Region": "us-east-1",
      "Path": "/giom/prod/canais/"
    }
  },
  "Sentry": {
    "Dsn": "", // secret — valor real só no SSM (/giom/prod/canais/Sentry/Dsn)
    "Environment": "pipeline-prod",
    "TracesSampleRate": 1.0
  },
  "Supabase": {
    "Url": "https://postgrest-production-59c5.up.railway.app",
    "SecretKey": "", // secret — valor real só no SSM (/giom/prod/canais/Supabase/SecretKey)
    "RestPrefix": ""
  },
  "FilaTranscricao": {
    "Provider": "Sqs",
    "Sqs": {
      "QueueName": "giom-videos-transcricao-prod",
      "Region": "us-east-1"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ingestao-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{ShortSourceContext}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
