# Variáveis de ambiente para as Edge Functions
# Copie para .env e preencha os valores reais
# NÃO comite o .env no git

OPENAI_API_KEY=sk-...
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Nova nomenclatura Supabase (substitui anon / service_role)
SUPABASE_ANON_KEY=sb_publishable_...        # injetada automaticamente pelo runtime das Edge Functions
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # injetada automaticamente pelo runtime das Edge Functions
