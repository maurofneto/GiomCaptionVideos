# Copie para .env.local (git-ignorado) e preencha. Na Vercel: Preview = dev, Production = prod.
# NUNCA commitar valores reais neste arquivo — só nomes e comentários.

# --- Sessão / acesso -------------------------------------------------------------------------
# Segredo de assinatura da sessão e de criptografia do cookie de state (>= 32 caracteres aleatórios).
SESSION_SECRET=
# E-mails autorizados, separados por vírgula. Qualquer outro recebe 403 em todas as rotas.
ALLOWED_EMAILS=

# --- Client OAuth do SIGN-IN (separado; escopos só "openid email") ----------------------------
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# URL exata cadastrada no client: https://<dominio-fixo>/api/auth/callback
AUTH_REDIRECT_URI=

# --- Client OAuth do YOUTUBE: tipo "Web application" (o fluxo Desktop dos workers não serve) ----
# Os workers do ambiente precisam passar a usar este MESMO ClientId/Secret (ver README).
YOUTUBE_GOOGLE_CLIENT_ID=
YOUTUBE_GOOGLE_CLIENT_SECRET=
# URL exata cadastrada no client: https://<dominio-fixo>/api/youtube/callback (mesma origem do AUTH_REDIRECT_URI)
YOUTUBE_REDIRECT_URI=
# Publicação do app OAuth no Google Cloud: "testing" (refresh token expira) ou "production".
OAUTH_APP_MODE=
# Dias de validade do refresh token em modo testing (opcional, padrão 7).
OAUTH_TESTING_EXPIRY_DAYS=
# Revogar o token obtido quando a conta não gerencia o canal / o escopo veio errado (opcional,
# padrão false). Os dois canais usam o mesmo client OAuth e o Google revoga o grant INTEIRO da
# conta para esse client, o que pode derrubar um token vivo de OUTRO canal. Com false (padrão)
# nada é revogado (o token obtido fica ativo até expirar ou ser removido em
# myaccount.google.com/permissions); com true é revogado. Nos dois modos nada é gravado.
OAUTH_REVOKE_ON_MISMATCH=

# --- AWS (SSM) --------------------------------------------------------------------------------
# Prefixo "RECONEXAO_" porque a Vercel reserva nomes AWS_* no runtime.
RECONEXAO_AWS_REGION=
# Credencial do IAM user giom-{env}-reconexao-vercel (policy mínima: ver README).
RECONEXAO_AWS_ACCESS_KEY_ID=
RECONEXAO_AWS_SECRET_ACCESS_KEY=
# /giom/dev (Preview) ou /giom/prod (Production) — sem barra final.
SSM_PREFIX=
# KeyId/ARN/alias da chave KMS do ambiente usada nos SecureString.
SSM_KMS_KEY_ID=
# Tier dos parâmetros de cookies: Standard (limite 4 KB) ou Advanced (8 KB).
# Advanced exige kms:GenerateDataKey na policy IAM (além de kms:Encrypt), é irreversível no
# parâmetro (não volta para Standard) e tem custo mensal; só use se o cookies.txt filtrado passar de 4 KB.
SSM_COOKIES_TIER=

# --- Fonte de canais (PostgREST com canal_ingestao) -------------------------------------------
# Espelha Supabase:Url / Supabase:RestPrefix dos workers .NET. Preview (dev) aponta para o
# PostgREST de dev; Production aponta para o Supabase de prod.
# Origem https (http só em localhost), sem caminho. Ex. prod: https://<ref>.supabase.co
CANAIS_API_URL=
# Opcional, padrão vazio (dev). Em prod: /rest/v1
CANAIS_API_REST_PREFIX=
# OBRIGATÓRIO. JWT da role reconexao_leitura (SELECT só em canal_ingestao.{channel_id,nome,
# secrets_key,ativo}; role criada pelo PR-03b). Enviado sempre como "Authorization: Bearer".
# Gerado pelo Mauro (infra) — ver README. NÃO é a service_role nem a anon key.
CANAIS_API_TOKEN=
# Opcional. Enviado como header "apikey" só quando definido (gateway do Supabase: publishable/anon key).
CANAIS_API_KEY=
